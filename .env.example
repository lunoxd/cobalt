# Cobalt Platform Environment Configuration

# Server
PORT=8080
ENV=development # Set to "production" in deployed environments

# Database (PostgreSQL 16)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cobalt?sslmode=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m

# PostgreSQL Container Defaults (for docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cobalt

# Administration & Security
# WARNING: Change this secret before deploying to production!
ADMIN_API_KEY=cb_admin_secret_key_change_in_prod

# Authentication Provider
# Options: "header" (reads Bearer/X-API-Key), "jwt", "dev"
AUTH_PROVIDER=header
AUTH_JWT_SECRET=

# Rate Limiting (In-memory token bucket)
RATE_LIMIT_RPS=50
RATE_LIMIT_BURST=100

# Webhooks
WEBHOOK_SECRET=whsec_cobalt_default_secret

# CORS
CORS_ALLOWED_ORIGINS=*

# Frontend Dashboard
NEXT_PUBLIC_API_URL=http://localhost:8080
